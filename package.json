{
  "name": "fivem-launcher-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web panel for the FiveM Server Launcher. Runs on a VPS and connects to the launcher with its port and token.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p server/tsconfig.json",
    "test": "node --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "fastify": "^5.12.8",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
