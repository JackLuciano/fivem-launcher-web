# Address the panel listens on. Keep 127.0.0.1 and put Caddy/nginx/Cloudflare Tunnel in front for HTTPS.
HOST=127.0.0.1
PORT=8080

# The launcher to connect to: the server PC's address and the port from the launcher's Web panel page.
LAUNCHER_URL=ws://192.168.1.20:47801

# The token shown on the launcher's Web panel page.
LAUNCHER_TOKEN=

# true when the panel is served over HTTPS (required for the session cookie on the internet).
COOKIE_SECURE=true

# true when a reverse proxy sits in front, so client IPs come from X-Forwarded-For.
TRUST_PROXY=true

# Where the translation cache and the audit log are kept.
DATA_DIR=./data

# How long a login stays valid without activity.
SESSION_HOURS=12
