# Address the panel listens on. Keep 127.0.0.1 and put Caddy/nginx/Cloudflare Tunnel in front for HTTPS.
HOST=127.0.0.1
PORT=8080

# The launcher to connect to: the server PC's address and the port from the launcher's Web panel page.
# The link is always TLS-encrypted (wss://); point it straight at the launcher, not through an HTTP proxy.
LAUNCHER_URL=wss://192.168.1.20:47801

# The token shown on the launcher's Web panel page. It is never sent over the network.
LAUNCHER_TOKEN=

# true when the panel is served over HTTPS (required for the session cookie on the internet).
COOKIE_SECURE=true

# true when a reverse proxy on this machine (127.0.0.1) sits in front, so the client IP comes from X-Forwarded-For.
# Only the loopback proxy is trusted. Use a comma-separated list of proxy addresses/CIDRs for anything else.
TRUST_PROXY=true

# The panel's public address, e.g. https://panel.example.com. Requests and sockets from other origins are refused.
# Leave empty to accept the address the browser used (Host header).
PUBLIC_ORIGIN=

# Where the translation cache and the audit log are kept.
DATA_DIR=./data

# How long a login stays valid without activity (1–720). A login never lasts longer than 7 days.
SESSION_HOURS=12
